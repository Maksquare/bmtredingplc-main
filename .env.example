# ==============================================================================
# bmtradingplc - Master Environment Configuration
# Architecture: Supabase (Auth + PostgreSQL Database) + cPanel (File Storage & Mail)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC SITE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://bmtradingplc.com

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (AUTHENTICATION & POSTGRESQL DATABASE)
# ------------------------------------------------------------------------------
# Find these in your Supabase Dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY and must NEVER be exposed to the browser.
# Used by server API routes to perform secure queries, manage RFQs, and sync data.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. cPANEL FILE STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# All uploaded product photos, jobsite gallery images, and PDF spec sheets are
# stored on your cPanel hosting account.

# Option A: Direct Disk Mode (When Next.js runs directly on cPanel via Node.js App Selector)
# UPLOAD_DIR should point to your public_html or cPanel storage folder:
UPLOAD_DIR=/home/bmtuser/public_html/uploads
NEXT_PUBLIC_CPANEL_MEDIA_URL=https://bmtradingplc.com/uploads

# Option B: Remote HTTP Bridge Mode (When Next.js runs on Vercel/Railway/Cloud)
# Place cpanel-storage/upload.php in public_html/api/upload.php on your cPanel server.
CPANEL_UPLOAD_ENDPOINT=https://files.bmtradingplc.com/api/upload.php
CPANEL_UPLOAD_SECRET=bmt_cpanel_secure_storage_token_2026
NEXT_PUBLIC_ASSETS_BASE_URL=https://files.bmtradingplc.com/uploads

# ------------------------------------------------------------------------------
# 4. cPANEL MAILBOX SMTP (TRANSACTIONAL NOTIFICATIONS)
# ------------------------------------------------------------------------------
SMTP_HOST=mail.bmtradingplc.com
SMTP_PORT=465
SMTP_USER=info@bmtradingplc.com
SMTP_PASSWORD=your-cpanel-mailbox-password-here
SMTP_SECURE=true

# ------------------------------------------------------------------------------
# 5. RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
