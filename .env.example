# ==============================================================================
# bmtredingplc - Environment Variables Configuration
# Domain: bmtredingplc.com
# Assets Subdomain: files.bmtredingplc.com
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://bmtredingplc.com
NEXT_PUBLIC_ASSETS_BASE_URL=https://files.bmtredingplc.com

# File Storage Configuration (Local Disk on cPanel)
# UPLOAD_DIR should be outside the redeploy application root, e.g.:
# /home/<cpanel-user>/uploads
UPLOAD_DIR=/home/bmtuser/uploads
USE_FALLBACK_FILE_SERVER=false

# Supabase Configuration (PostgreSQL Database & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY and must NEVER be exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# cPanel Mailbox SMTP Configuration (e.g. info@bmtredingplc.com)
SMTP_HOST=mail.bmtredingplc.com
SMTP_PORT=465
SMTP_USER=info@bmtredingplc.com
SMTP_PASSWORD=your-cpanel-mailbox-password-here
SMTP_SECURE=true

# Application Mode
NODE_ENV=production
PORT=3000

